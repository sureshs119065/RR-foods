# /etc/systemd/system/nk.service    then: systemctl daemon-reload && systemctl enable --now nk
[Unit]
Description=Nurse's Kitchen shop (gunicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=nk
Group=nk
WorkingDirectory=/srv/nk
EnvironmentFile=/srv/nk/.env
ExecStart=/srv/nk/venv/bin/gunicorn -c gunicorn.conf.py wsgi:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
