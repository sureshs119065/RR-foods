# Copy to .env on the SERVER (never commit it). Then run:  flask check-config
FLASK_APP=wsgi.py
FLASK_ENV=production

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# A real database user with a strong password (not the example one)
DATABASE_URL=postgresql+psycopg://nk_user:STRONG_PASSWORD@localhost:5432/nk

# Your public address, https only
SITE_URL=https://shop.example.com
# 1 when nginx / a load balancer sits in front (needed for correct visitor IPs)
TRUST_PROXY=1

# Rate limits shared by all workers (install Redis: apt install redis-server)
RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# Absolute path on a disk that is backed up
UPLOAD_DIR=/var/lib/nk/uploads
MAX_UPLOAD_MB=30
SHOP_TIMEZONE=Asia/Kolkata

# WhatsApp ordering (free). Customers send their order to this number; the owner takes payment on WhatsApp and marks it paid.
# Digits only, with country code. REQUIRED for a live shop.
ADMIN_WHATSAPP_NUMBER=
DEFAULT_COUNTRY_CODE=91
SHOP_NAME=RR FOODS

# Email (password reset, order updates). Also add the cron line from deploy/crontab.txt
MAIL_MODE=smtp
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=1
MAIL_FROM=Nurse's Kitchen <no-reply@shop.example.com>

# Only used by `flask seed`. Prefer `flask create-user` in production and do NOT seed sample data on a live shop.

# Optional customer support links
WHATSAPP_NUMBER=
SUPPORT_EMAIL=
MAX_UPLOAD_MB=60

# Phase 5 logging and security
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
APP_VERSION=1.0.0
SESSION_COOKIE_SECURE=1
LOGIN_IP_LOCKOUT_ENABLED=1
LOGIN_IP_MAX_FAILED=12

# Optional Web Push: generate VAPID keys once; never expose the private key.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@example.com
