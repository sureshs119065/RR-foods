# Copy to .env on the SERVER (never commit it). Then run:  flask check-config
FLASK_APP=wsgi.py
FLASK_ENV=production

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# A real database user with a strong password (not the example one)
DATABASE_URL=postgresql+psycopg://nk_user:STRONG_PASSWORD@localhost:5432/nk

# Your public address, https only
SITE_URL=https://shop.example.com
# 1 when nginx / a load balancer sits in front (needed for correct visitor IPs)
TRUST_PROXY=1

# Rate limits shared by all workers (install Redis: apt install redis-server; Render: create a Key Value instance).
# REQUIRED: the site refuses to start with the in-memory default. Individual limits: RATE_LIMIT_<NAME>, see app/ratelimits.py.
RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# Absolute path on a disk that is backed up
UPLOAD_DIR=/var/lib/nk/uploads
MAX_UPLOAD_MB=30
CUSTOMER_MAX_UPLOAD_MB=16   # review photos: 3 x 5 MB plus form fields
SHOP_TIMEZONE=Asia/Kolkata

# WhatsApp ordering (free). Customers send their order to this number; the owner takes payment on WhatsApp and marks it paid.
# Digits only, with country code. REQUIRED for a live shop.
ADMIN_WHATSAPP_NUMBER=
DEFAULT_COUNTRY_CODE=91
SHOP_NAME=RR FOODS

# Email (password reset, order updates). Also add the cron line from deploy/crontab.txt
MAIL_MODE=smtp
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=1
MAIL_FROM=RR FOODS <no-reply@shop.example.com>

# Optional customer support links
WHATSAPP_NUMBER=
SUPPORT_EMAIL=
SHOP_ADDRESS=
SHOP_HOURS=
MAX_UPLOAD_MB=60

# Phase 5 logging and security
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
APP_VERSION=1.0.0
# Cookies are always Secure when FLASK_ENV=production; this line only matters for local HTTPS testing.
SESSION_COOKIE_SECURE=1
LOGIN_IP_LOCKOUT_ENABLED=1
LOGIN_IP_MAX_FAILED=12

# Optional Web Push: generate VAPID keys once; never expose the private key.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@example.com

# Per-worker cache of the home page categories and New Arrivals, in seconds (0 = off). Product/category edits empty it at once on the worker that saved them.
HOME_CACHE_SECONDS=60

# Where researchers should report a vulnerability (published at /.well-known/security.txt). An email you actually read.
SECURITY_CONTACT=

# --- customer email sign-in codes (OTP). MAIL_MODE must be smtp or customers cannot get a code ---
# MAIL_MODE=smtp  MAIL_SERVER=smtp.gmail.com  MAIL_PORT=587  MAIL_USE_TLS=1  (use MAIL_USE_SSL=1 and MAIL_PORT=465 for SSL)
# MAIL_USERNAME=you@example.com   MAIL_PASSWORD=app-password   MAIL_FROM="RR FOODS <you@example.com>"
MAIL_SENDER_NAME=RR FOODS
# optional tuning (defaults shown)
# OTP_TTL_SECONDS=300  OTP_MAX_ATTEMPTS=5  OTP_RESEND_SECONDS=45  OTP_MAX_PER_EMAIL_HOUR=5  OTP_MAX_PER_IP_HOUR=10
