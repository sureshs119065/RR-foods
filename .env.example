# Copy to .env and edit. Never commit the real .env file.
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
# PostgreSQL connection (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://nk_user:nk_password@localhost:5432/nk
# Optional: passwords for the seeded accounts. If left empty, random ones are generated and printed once by `flask seed`.
SEED_ADMIN_EMAIL=admin@nurseskitchen.local
SEED_ADMIN_PASSWORD=
SEED_OWNER_EMAIL=owner@nurseskitchen.local
SEED_OWNER_PASSWORD=
# Uploads (product and banner images)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=30

# Time zone for banner, coupon and offer dates typed in the admin panel
SHOP_TIMEZONE=Asia/Kolkata
# WhatsApp ordering (free, no API). The shop's WhatsApp number: digits only, with country code, e.g. 919876543210
ADMIN_WHATSAPP_NUMBER=
DEFAULT_COUNTRY_CODE=91
SHOP_NAME=RR FOODS

# Email (Step 7). off | console | smtp. Run `flask send-emails` every minute from cron.
MAIL_MODE=console
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=1
MAIL_FROM=Nurse's Kitchen <no-reply@example.com>
SITE_URL=http://localhost:5000

# Optional customer support links
WHATSAPP_NUMBER=
SUPPORT_EMAIL=
MAX_UPLOAD_MB=60
